# Fotos originales sin normalizar (pueden tener EXIF con geolocalización,
# fecha/hora precisa, datos del dispositivo, o rostros sin consentimiento
# de publicación). Nunca van al repositorio público.
datos/corpus_original/

# Imágenes normalizadas SIN consentimiento de publicación.
# Solo copiamos a corpus_normalizado/ las que sí tienen consentimiento;
# ver README > "Consentimiento y alcance ético".
datos/corpus_normalizado_privado/

# Referencias del corpus: una fila por foto con el nombre y apellido de la
# persona autora (autor_apellido_nombre). Es dato personal, así que nunca se
# sube al repositorio público ni se comparte. El dataset analítico equivalente
# y sin nombres es metadata_normalizado.csv / dataset.csv.
datos/referencias.csv
# Nombre viejo del mismo archivo (por si reaparece en ramas o historial).
datos/metadata.csv

# Consentimientos, planillas con datos personales, anexo institucional,
# y cualquier archivo *_privado.* que se genere en el futuro (resguardo
# genérico, aunque hoy ningún script del pipeline escribe uno).
anexo_restringido/
*.consentimiento.*
*_privado.csv
*_privado/

# Entornos y cachés de Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Sistema
.DS_Store
